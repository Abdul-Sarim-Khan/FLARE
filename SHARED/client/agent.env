# FLARE v0.4 Agent Configuration
# Paths below are relative to the client directory.
# They are resolved automatically by flare_agent.py at startup.
#
# SETUP INSTRUCTIONS:
#   1. Run  setup\0_run_all_setup.ps1  (installs deps, creates dirs, prompts for settings)
#   2. On the SERVER run:  python generate_pki.py --client <THIS-HOSTNAME>
#   3. Copy these 3 files to the certs\ folder in THIS directory:
#        server\certs\ca.crt                           --> certs\ca.crt
#        server\certs\clients\<HOSTNAME>\client.crt    --> certs\client.crt
#        server\certs\clients\<HOSTNAME>\client.key    --> certs\client.key
#   4. Edit FLARE_SERVER_URL below (or re-run 3_configure.ps1)

FLARE_SERVER_URL=https://ENTER-SERVER-IP-HERE:7331
FLARE_CA_CERT=certs\ca.crt
FLARE_CLIENT_CERT=certs\client.crt
FLARE_CLIENT_KEY=certs\client.key
FLARE_NET_CSV=net_flows.csv
FLARE_LOG_LEVEL=INFO
FLARE_FL_TEST_MODE=0
